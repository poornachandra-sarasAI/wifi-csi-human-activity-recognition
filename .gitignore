# ---------------------------------------------------------------
# Source dataset: never committed (challenge spec section 4).
# Work from the shared data location; keep only code + results here.
# ---------------------------------------------------------------
raw/

# ---------------------------------------------------------------
# Derived data. Ignored by GLOB, not by directory, so that the
# directory structure and the committed manifest stay visible.
# Regenerate with: python -m src.<stage>   (see README)
# ---------------------------------------------------------------
intermediate_csv/**/*.csv
windows/**/*.npy

# Fitted normalization statistics are small and ARE committed
# (results/norm_*.npz) so that run_episode.py is deterministic.

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environment
.venv/
venv/
.env
.env.local

# Jupyter
.ipynb_checkpoints/

# Torch checkpoints
*.pt
*.pth
# Task 2's trained encoders are small (1.1 MB each) and committed so Task 3
# can call load_pretrained() without a 45-minute retrain.
!models/task2_encoder_*.pt

# Logs
*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
