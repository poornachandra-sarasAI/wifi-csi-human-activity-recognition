\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Hungarian optimal-assignment diagnostic: the best Macro-F1 reachable by any one-to-one relabelling of the predicted classes. The optimal permutation swaps \textsc  {Sit}$\leftrightarrow $\textsc  {Walk} in \emph  {both} directions (Room~A additionally swaps \textsc  {Stand}$\leftrightarrow $\textsc  {Fall}); all other activities map to themselves. This is an \emph  {oracle} computed from validation labels --- a diagnostic upper bound, never an achieved result.}}{8}{table.caption.9}\protected@file@percent }
\newlabel{tab:hungarian_bound}{{5}{8}{Hungarian optimal-assignment diagnostic: the best Macro-F1 reachable by any one-to-one relabelling of the predicted classes. The optimal permutation swaps \textsc {Sit}$\leftrightarrow $\textsc {Walk} in \emph {both} directions (Room~A additionally swaps \textsc {Stand}$\leftrightarrow $\textsc {Fall}); all other activities map to themselves. This is an \emph {oracle} computed from validation labels --- a diagnostic upper bound, never an achieved result}{table.caption.9}{}}
